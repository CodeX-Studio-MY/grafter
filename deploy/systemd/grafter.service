# Nightly Grafter run (TODO 1D5). Install: see docs/operations.md.
[Unit]
Description=Grafter nightly run
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=grafter
Group=grafter
# Secrets (GRAFTER_GITHUB_APP_PRIVATE_KEY_FILE, LITELLM_MASTER_KEY, ...) live here, mode 0600.
EnvironmentFile=/home/grafter/.grafter/env
ExecStart=/opt/grafter/.venv/bin/grafter run --config /home/grafter/.grafter/grafter.yaml
TimeoutStartSec=5h
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/grafter/.grafter
