# Copy to .env (git-ignored), fill in, then: chmod 600 .env
ANTHROPIC_API_KEY=
# Admin key for Grafter only. Must start with sk-. Generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts stored credentials. Set once, never change. Generate: openssl rand -hex 32
LITELLM_SALT_KEY=
# Password for LiteLLM's private Postgres. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
